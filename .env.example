# -------------------------------------------------
# Root .env file (copy to .env and fill values)
# -------------------------------------------------
# Supabase (client side)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase admin (backend) – use service role key for server‑side actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL (local Docker instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/simplecash

# JWT secret for API authentication
JWT_SECRET=super‑secret‑jwt-key

# Twilio (or Meta) credentials for WhatsApp reminders
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# OR – Meta WhatsApp Business API credentials (if you prefer)
META_WHATSAPP_TOKEN=your_meta_token
META_WHATSAPP_BUSINESS_ID=your_business_id

# App settings
APP_URL=http://localhost:3000
